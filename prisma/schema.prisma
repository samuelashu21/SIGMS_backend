  @@map("report_card_subjects")
}



model ReportCardAttendance {
  id          String @id @default(uuid()) @db.Uuid
  schoolId    String @map("school_id") @db.Uuid
  reportCardId String @unique @map("report_card_id") @db.Uuid

  totalSessions Int @default(0) @map("total_sessions")
  presentDays   Int @default(0) @map("present_days")
  absentDays    Int @default(0) @map("absent_days")
  lateDays      Int @default(0) @map("late_days")
  excusedDays   Int @default(0) @map("excused_days")
  halfDays      Int @default(0) @map("half_days")

  attendancePercentage Decimal? @map("attendance_percentage") @db.Decimal(8, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reportCard ReportCard @relation(fields: [reportCardId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([reportCardId, schoolId])
  @@unique([id, schoolId])
  @@map("report_card_attendance")
}



enum ReportCardHistoryAction {
  CREATED
  GENERATED
  UPDATED
  PUBLISHED
  WITHDRAWN

  @@map("report_card_history_actions")
}

model ReportCardHistory {
  id           String @id @default(uuid()) @db.Uuid
  schoolId     String @map("school_id") @db.Uuid
  reportCardId String @map("report_card_id") @db.Uuid
  performedById String @map("performed_by_id") @db.Uuid

  action ReportCardHistoryAction
  description String? @db.Text
  previousValues Json? @map("previous_values")
  newValues Json? @map("new_values")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reportCard ReportCard @relation(fields: [reportCardId, schoolId], references: [id, schoolId], onDelete: Cascade)
  performedBy User @relation("ReportCardHistoryActor", fields: [performedById], references: [id], onDelete: Restrict)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, reportCardId, createdAt])
  @@map("report_card_history")
