
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model School {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  schoolCode  String     @unique @map("school_code")
  schoolType  SchoolType @map("school_type")

  region      String?
  zone        String?
  woreda      String?
  city        String?
  address     String?

  phone       String?
  email       String?

  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  students    Student[]
  memberships UserSchoolMembership[]
  configuration SchoolConfiguration?

  academicYears AcademicYear[]

  semesters Semester[]
  grades Grade[]
  sections Section[]

  subjects Subject[]

  gradeSubjectAssignments GradeSubject[]

  academicConfiguration AcademicConfiguration?
  gradingSystems GradingSystem[]
  academicCalendarEvents AcademicCalendarEvent[]
  admissionApplications AdmissionApplication[]
  studentIdSequences StudentIdSequence[]
  academicEnrollments AcademicEnrollment[]

  outgoingStudentTransfers StudentTransfer[] @relation("StudentTransferSource")
  incomingStudentTransfers StudentTransfer[] @relation("StudentTransferDestination")
  teacherProfiles TeacherProfile[]
  staffProfiles StaffProfile[]
  guardianProfiles GuardianProfile[]
  examinations Examination[]
  examinationTypeConfigurations ExaminationTypeConfiguration[]
  quizzes Quiz[]
  assignments Assignment[]
  examinationGradingConfigurations ExaminationGradingConfiguration[]
  examinationHistory ExaminationHistory[]

  markRecords MarkRecord[]
  markCorrections MarkCorrection[]
  academicGradingConfigurations AcademicGradingConfiguration[]
  subjectGradeResults SubjectGradeResult[]
  semesterAcademicAverages SemesterAcademicAverage[]
  annualAcademicAverages AnnualAcademicAverage[]

  academicSubjectWeights AcademicSubjectWeight[]
  academicSemesterWeights AcademicSemesterWeight[]

  academicPerformanceSummaries AcademicPerformanceSummary[]

  academicRankingConfigurations AcademicRankingConfiguration[]
  academicStudentRankings AcademicStudentRanking[]

  academicPerformanceHistory AcademicPerformanceHistory[]

  reportCards ReportCard[]
  reportCardSubjects ReportCardSubject[]
  reportCardHistory ReportCardHistory[]

  studentAcademicTranscripts StudentAcademicTranscript[]
  academicTranscriptEntries AcademicTranscriptEntry[]
  academicTranscriptHistory AcademicTranscriptHistory[]

  attendanceReports AttendanceReport[]

  @@index([schoolType], map: "schools_school_type_idx")
  @@index([region, zone], map: "schools_region_zone_idx")
  @@index([isActive], map: "schools_is_active_idx")
  @@map("schools")
}



model Student {
  id                    String   @id @default(uuid()) @db.Uuid
  schoolId              String   @map("school_id") @db.Uuid
  admissionApplicationId String? @unique @map("admission_application_id") @db.Uuid

  fullName   String   @map("full_name")
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender     ApplicantGender?
  isActive   Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id],onDelete: Restrict)

  admissionApplication AdmissionApplication? @relation(fields: [admissionApplicationId], references: [id],onDelete: Restrict)

  profile StudentProfile?
  studentNumber String? @map("student_number")
  academicEnrollments AcademicEnrollment[]
  transfers StudentTransfer[]

  academicRecords StudentAcademicRecord[]
  guardianRelationships StudentGuardianRelationship[]
  attendanceRecords AttendanceRecord[]
  markRecords MarkRecord[]
  subjectGradeResults SubjectGradeResult[]
  semesterAcademicAverages SemesterAcademicAverage[]
  annualAcademicAverages AnnualAcademicAverage[]

  academicPerformanceSummaries AcademicPerformanceSummary[]
  academicStudentRankings AcademicStudentRanking[]
  academicPerformanceHistory AcademicPerformanceHistory[]

  reportCards ReportCard[]

  academicTranscripts StudentAcademicTranscript[]

  attendanceReports AttendanceReport[]

  @@unique([schoolId, studentNumber], map: "students_school_student_number_key")
  @@unique([id, schoolId], map: "students_id_school_key")
  @@index([schoolId], map: "students_school_id_idx")
  @@index([schoolId, isActive], map: "students_school_active_idx")
  @@index([schoolId, fullName], map: "students_school_name_idx")
  @@map("students")
}



model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  schoolId  String?   @map("school_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([schoolId], map: "auth_sessions_school_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}


enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  VICE_PRINCIPAL
  REGISTRAR
  TEACHER
  STUDENT
  PARENT

  @@map("user_roles")
}



model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String?   @unique
  username     String?   @unique
  passwordHash String    @map("password_hash")
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  passwordResetTokens PasswordResetToken[]
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  @@index([deletedAt], map: "users_deleted_at_idx")
  
  sessions AuthSession[]
  actorActivityLogs  UserActivityLog[] @relation("UserActivityActor")
  targetActivityLogs UserActivityLog[] @relation("UserActivityTarget")
  memberships UserSchoolMembership[]
  createdAdmissionApplications AdmissionApplication[]
  uploadedAdmissionDocuments AdmissionDocument[]
  admissionReviews AdmissionReview[]
  admissionDecisions AdmissionApplication[] @relation("AdmissionDecisionActor")
  admissionStatusChanges AdmissionStatusHistory[]

  requestedStudentTransfers StudentTransfer[] @relation("StudentTransferRequester")
  reviewedStudentTransfers StudentTransfer[] @relation("StudentTransferReviewer")
  enrollmentHistoryChanges EnrollmentHistory[]
  createdStudentAcademicRecords StudentAcademicRecord[]
  teacherProfiles TeacherProfile[]
  staffProfiles StaffProfile[]
  guardianProfiles GuardianProfile[]
  verifiedGuardianRelationships StudentGuardianRelationship[] @relation("GuardianRelationshipVerifier")
  recordedAttendance ClassAttendance[] @relation("AttendanceRecorder")
  approvedAttendance ClassAttendance[] @relation("AttendanceApprover")
  requestedAttendanceCorrections AttendanceCorrection[] @relation("AttendanceCorrectionRequester")
  reviewedAttendanceCorrections AttendanceCorrection[] @relation("AttendanceCorrectionReviewer")
  createdExaminations Examination[] @relation("ExaminationCreator")
  examinationHistoryActions ExaminationHistory[]
  enteredMarkRecords MarkRecord[] @relation("MarkRecordEnteredBy")
  approvedMarkRecords MarkRecord[] @relation("MarkRecordApprovedBy")
  reviewedMarkRecords MarkRecord[] @relation("MarkRecordReviewedBy")
  requestedMarkCorrections MarkCorrection[] @relation("MarkCorrectionRequester")
  reviewedMarkCorrections MarkCorrection[] @relation("MarkCorrectionReviewer")
  publishedMarkRecords MarkRecord[] @relation("MarkRecordPublisher")
  academicPerformanceHistoryActions AcademicPerformanceHistory[] @relation("AcademicPerformanceHistoryActor")

  createdReportCards ReportCard[] @relation("ReportCardCreator")
  publishedReportCards ReportCard[] @relation("ReportCardPublisher")
  reportCardHistoryActions ReportCardHistory[] @relation("ReportCardHistoryActor")

  createdTranscripts StudentAcademicTranscript[] @relation("TranscriptCreator")
  publishedTranscripts StudentAcademicTranscript[] @relation("TranscriptPublisher")
  transcriptHistoryActions AcademicTranscriptHistory[] @relation("TranscriptHistoryActor")

  generatedAttendanceReports AttendanceReport[] @relation("AttendanceReportGenerator")

  @@map("users")
}



model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "password_reset_tokens_user_id_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}



model UserActivityLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  targetUserId String   @map("target_user_id") @db.Uuid
  action       String
  details      Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User @relation( "UserActivityActor", fields: [actorId], references: [id], onDelete: Restrict)

  targetUser User @relation( "UserActivityTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt], map: "user_activity_actor_created_idx")
  @@index([targetUserId, createdAt], map: "user_activity_target_created_idx")
  @@index([action], map: "user_activity_action_idx")
  @@map("user_activity_logs")
}



model UserSchoolMembership {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  role      UserRole
  isActive  Boolean   @default(true) @map("is_active")
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation( fields: [userId], references: [id], onDelete: Restrict)

  school School @relation( fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([userId, schoolId], map: "user_school_memberships_user_school_key")
  @@index([schoolId, role], map: "user_school_memberships_school_role_idx")
  @@index([userId, isActive], map: "user_school_memberships_user_active_idx")
  @@map("user_school_memberships")
}



enum SchoolType {
  ELEMENTARY
  SECONDARY
  PREPARATORY
  COMBINED

  @@map("school_types")
}




enum SchoolLanguage {
  ENGLISH
  AMHARIC

  @@map("school_languages")
}

enum SchoolCalendarType {
  GREGORIAN
  ETHIOPIAN

  @@map("school_calendar_types")
}

model SchoolConfiguration {
  id                  String             @id @default(uuid()) @db.Uuid
  schoolId            String             @unique @map("school_id") @db.Uuid

  defaultLanguage     SchoolLanguage     @default(ENGLISH) @map("default_language")
  calendarType        SchoolCalendarType @default(GREGORIAN) @map("calendar_type")
  timezone            String             @default("Africa/Addis_Ababa")
  academicYearLabel   String             @default("GREGORIAN") @map("academic_year_label")

  attendanceEnabled   Boolean            @default(true) @map("attendance_enabled")
  notificationsEnabled Boolean          @default(true) @map("notifications_enabled")
  parentAccessEnabled Boolean            @default(true) @map("parent_access_enabled")


  academicYearStartMonth       Int     @default(9) @map("academic_year_start_month")
  weekStartsOn                 Int     @default(1) @map("week_starts_on")
  attendanceCutoffTime         String  @default("08:30") @map("attendance_cutoff_time")
  requireMarksApproval         Boolean @default(true) @map("require_marks_approval")
  allowStudentResultAccess     Boolean @default(true) @map("allow_student_result_access")
  allowParentResultAccess      Boolean @default(true) @map("allow_parent_result_access")


  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School @relation( fields: [schoolId],references: [id], onDelete: Cascade)

  @@map("school_configurations")
}



enum AcademicYearStatus {
  PLANNED
  ACTIVE
  COMPLETED

  @@map("academic_year_statuses")
}

model AcademicYear {
  id        String            @id @default(uuid()) @db.Uuid
  schoolId  String            @map("school_id") @db.Uuid
  name      String
  startDate DateTime          @map("start_date") @db.Date
  endDate   DateTime          @map("end_date") @db.Date
  status    AcademicYearStatus @default(PLANNED)
  isCurrent Boolean           @default(false) @map("is_current")

  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  school    School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  semesters Semester[]
  sections Section[]
  calendarEvents AcademicCalendarEvent[]
  admissionApplications AdmissionApplication[]
  studentIdSequences StudentIdSequence[]
  enrollments AcademicEnrollment[]
  teacherAssignments TeacherSubjectAssignment[]
  teacherClassAssignments TeacherClassAssignment[]
  homeroomAssignments HomeroomTeacherAssignment[]
  teacherWorkloadRecords TeacherWorkloadRecord[]
  classAttendance ClassAttendance[]
  examinations Examination[]
  academicGradingConfigurations AcademicGradingConfiguration[]
  subjectGradeResults SubjectGradeResult[]
  semesterAcademicAverages SemesterAcademicAverage[]
  annualAcademicAverages AnnualAcademicAverage[]

  academicSubjectWeights AcademicSubjectWeight[]
  academicSemesterWeights AcademicSemesterWeight[]

  academicPerformanceSummaries AcademicPerformanceSummary[]

  academicRankingConfigurations AcademicRankingConfiguration[]
  academicStudentRankings AcademicStudentRanking[]
  academicPerformanceHistory AcademicPerformanceHistory[]

  reportCards ReportCard[]

  academicTranscriptEntries AcademicTranscriptEntry[]

  attendanceReports AttendanceReport[]

  @@unique([id, schoolId], map: "academic_years_id_school_key")

  @@unique([schoolId, name], map: "academic_years_school_name_key")
  @@index([schoolId, status], map: "academic_years_school_status_idx")
  @@index([schoolId, isCurrent], map: "academic_years_school_current_idx")
  @@map("academic_years")
}



enum SemesterStatus {
  PLANNED
  ACTIVE
  COMPLETED

  @@map("semester_statuses")
}


model Semester {
  id             String         @id @default(uuid()) @db.Uuid
  schoolId       String         @map("school_id") @db.Uuid
  academicYearId String         @map("academic_year_id") @db.Uuid
  name           String
  sequence       Int
  startDate      DateTime       @map("start_date") @db.Date
  endDate        DateTime       @map("end_date") @db.Date
  status         SemesterStatus @default(PLANNED)
  isCurrent      Boolean        @default(false) @map("is_current")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School @relation(fields: [schoolId],references: [id], onDelete: Restrict)

  academicYear AcademicYear @relation(fields: [academicYearId, schoolId],references: [id, schoolId],onDelete: Restrict)

  examinations Examination[]
  subjectGradeResults SubjectGradeResult[]
  semesterAcademicAverages SemesterAcademicAverage[]
  academicSemesterWeights AcademicSemesterWeight[]

  academicPerformanceSummaries AcademicPerformanceSummary[]

  academicStudentRankings AcademicStudentRanking[]

  academicPerformanceHistory AcademicPerformanceHistory[]

  reportCards ReportCard[]

  academicTranscriptEntries AcademicTranscriptEntry[]

  attendanceReports AttendanceReport[]

  // ADD THIS
  @@unique([id, schoolId], map: "semesters_id_school_key")

  @@unique([academicYearId, name], map: "semesters_year_name_key")
  @@unique([academicYearId, sequence], map: "semesters_year_sequence_key")
  @@index([schoolId, status], map: "semesters_school_status_idx")
  @@index([schoolId, academicYearId], map: "semesters_school_year_idx")

  @@map("semesters")
}




model Grade {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  name       String
  gradeLevel Int      @map("grade_level")
  description String?

  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School @relation( fields: [schoolId],  references: [id], onDelete: Restrict)

  sections Section[]

  subjectAssignments GradeSubject[]
  admissionApplications AdmissionApplication[]
  academicEnrollments AcademicEnrollment[]
  teacherAssignments TeacherSubjectAssignment[]
  examinations Examination[]
  academicSubjectWeights AcademicSubjectWeight[]

  academicRankingConfigurations AcademicRankingConfiguration[]
  academicStudentRankings AcademicStudentRanking[]

  reportCards ReportCard[]

  academicTranscriptEntries AcademicTranscriptEntry[]

  @@unique([schoolId, name], map: "grades_school_name_key")
  @@unique([schoolId, gradeLevel], map: "grades_school_level_key")
  @@unique([id, schoolId], map: "grades_id_school_key")
  @@index([schoolId, isActive], map: "grades_school_active_idx")
  @@map("grades")
}



model Section {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  gradeId        String   @map("grade_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid

  name           String
  capacity       Int?
  room           String?
  isActive       Boolean  @default(true) @map("is_active")

  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School @relation(  fields: [schoolId], references: [id],onDelete: Restrict )

  grade Grade @relation(  fields: [gradeId, schoolId], references: [id, schoolId], onDelete: Restrict)

  academicYear AcademicYear @relation(  fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict )

  academicEnrollments AcademicEnrollment[]
  teacherAssignments TeacherClassAssignment[]
  homeroomAssignments HomeroomTeacherAssignment[]
  classAttendance ClassAttendance[]
  examinations Examination[]

  academicStudentRankings AcademicStudentRanking[]

  reportCards ReportCard[]

  attendanceReports AttendanceReport[]

  @@unique([academicYearId, gradeId, name], map: "sections_year_grade_name_key")
  @@index([schoolId, academicYearId], map: "sections_school_year_idx")
  @@index([schoolId, gradeId], map: "sections_school_grade_idx")
  @@index([schoolId, isActive], map: "sections_school_active_idx")
  @@map("sections")

  @@unique([id, schoolId], map: "sections_id_school_key")

  @@unique([id, schoolId, gradeId, academicYearId],map: "sections_id_school_grade_year_key")
  
}



model Subject {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School @relation( fields: [schoolId], references: [id], onDelete: Restrict)

  gradeAssignments GradeSubject[]
  teacherAssignments TeacherSubjectAssignment[]
  examinations Examination[]
  subjectGradeResults SubjectGradeResult[]
  academicSubjectWeights AcademicSubjectWeight[]

  reportCardSubjects ReportCardSubject[]

  academicTranscriptEntries AcademicTranscriptEntry[]

  @@unique([schoolId, code], map: "subjects_school_code_key")
  @@unique([schoolId, name], map: "subjects_school_name_key")
  @@unique([id, schoolId], map: "subjects_id_school_key")
  @@index([schoolId, isActive], map: "subjects_school_active_idx")
  @@map("subjects")
}



model GradeSubject {
  id                String   @id @default(uuid()) @db.Uuid
  schoolId          String   @map("school_id") @db.Uuid
  gradeId           String   @map("grade_id") @db.Uuid
  subjectId         String   @map("subject_id") @db.Uuid

  weeklyPeriods     Int      @default(3) @map("weekly_periods")
  isCompulsory      Boolean  @default(true) @map("is_compulsory")
  isActive          Boolean  @default(true) @map("is_active")

  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School @relation( fields: [schoolId],references: [id], onDelete: Restrict )

  grade Grade @relation( fields: [gradeId, schoolId], references: [id, schoolId],onDelete: Restrict)

  subject Subject @relation( fields: [subjectId, schoolId], references: [id, schoolId],onDelete: Restrict )

  @@unique([schoolId, gradeId, subjectId], map: "grade_subjects_school_grade_subject_key")
  @@index([schoolId, gradeId], map: "grade_subjects_school_grade_idx")
  @@index([schoolId, subjectId], map: "grade_subjects_school_subject_idx")
  @@map("grade_subjects")
}



enum AcademicTermType {
  SEMESTER
  QUARTER
  TRIMESTER
  ANNUAL

  @@map("academic_term_types")
}

model AcademicConfiguration {
  id                    String           @id @default(uuid()) @db.Uuid
  schoolId              String           @unique @map("school_id") @db.Uuid
  termType              AcademicTermType @default(SEMESTER) @map("term_type")
  termsPerYear          Int              @default(2) @map("terms_per_year")
  passingPercentage     Decimal          @default(50) @map("passing_percentage") @db.Decimal(5, 2)
  maximumScore          Decimal          @default(100) @map("maximum_score") @db.Decimal(7, 2)
  allowMarksCorrection  Boolean          @default(false) @map("allow_marks_correction")
  requireMarksApproval  Boolean          @default(true) @map("require_marks_approval")
  allowIncompleteGrades Boolean          @default(false) @map("allow_incomplete_grades")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School @relation( fields: [schoolId], references: [id], onDelete: Restrict)

  @@map("academic_configurations")
}



model GradingSystem {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  gradeScales GradeScale[]
  academicGradingConfigurations AcademicGradingConfiguration[]

  @@unique([schoolId, name], map: "grading_systems_school_name_key")
  @@unique([id, schoolId], map: "grading_systems_id_school_key")
  @@index([schoolId, isActive], map: "grading_systems_school_active_idx")
  @@map("grading_systems")
}


model GradeScale {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @map("school_id") @db.Uuid
  gradingSystemId String   @map("grading_system_id") @db.Uuid

  letterGrade     String   @map("letter_grade")
  minimumScore    Decimal  @map("minimum_score") @db.Decimal(7, 2)
  maximumScore    Decimal  @map("maximum_score") @db.Decimal(7, 2)
  gradePoint      Decimal? @map("grade_point") @db.Decimal(5, 2)
  description     String?
  isPassing       Boolean  @default(false) @map("is_passing")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  gradingSystem GradingSystem @relation(fields: [gradingSystemId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([gradingSystemId, letterGrade], map: "grade_scales_system_letter_key")
  @@index([schoolId, gradingSystemId], map: "grade_scales_school_system_idx")
  @@map("grade_scales")
}



enum AcademicCalendarEventType {
  TERM_START
  TERM_END
  SCHOOL_DAY
  HOLIDAY
  EXAMINATION
  REGISTRATION
  MEETING
  CULTURAL_EVENT
  OTHER

  @@map("academic_calendar_event_types")
}


model AcademicCalendarEvent {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid

  title          String
  description    String?
