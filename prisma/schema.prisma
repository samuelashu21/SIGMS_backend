enum TranscriptStatus {
  DRAFT
  GENERATED
  PUBLISHED
  WITHDRAWN

  @@map("transcript_statuses")
}


model StudentAcademicTranscript {
  id        String @id @default(uuid()) @db.Uuid
  schoolId  String @map("school_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid

  transcriptNumber String @map("transcript_number") @db.VarChar(100)
  status TranscriptStatus @default(DRAFT)

  totalAcademicYears Int @default(0) @map("total_academic_years")
  totalSubjects      Int @default(0) @map("total_subjects")

  cumulativeGradePoint Decimal? @map("cumulative_grade_point") @db.Decimal(5, 2)
  cumulativePercentage Decimal? @map("cumulative_percentage") @db.Decimal(8, 2)

  generatedAt DateTime? @map("generated_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  publishedById String? @map("published_by_id") @db.Uuid

  createdById String @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Restrict)

  createdBy User @relation("TranscriptCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy User? @relation("TranscriptPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  entries AcademicTranscriptEntry[]
  history AcademicTranscriptHistory[]

  @@unique([schoolId, transcriptNumber])
  @@unique([id, schoolId])
  @@index([schoolId, studentId, createdAt])
  @@index([schoolId, status])
  @@map("student_academic_transcripts")
}

model AcademicTranscriptEntry {
  id           String @id @default(uuid()) @db.Uuid
  schoolId     String @map("school_id") @db.Uuid
  transcriptId String @map("transcript_id") @db.Uuid

  academicYearId String @map("academic_year_id") @db.Uuid
  gradeId        String @map("grade_id") @db.Uuid
  semesterId     String? @map("semester_id") @db.Uuid
  subjectId      String @map("subject_id") @db.Uuid

  periodKey String @map("period_key") @db.VarChar(100)

  academicYearName String @map("academic_year_name") @db.VarChar(100)
  gradeName        String @map("grade_name") @db.VarChar(100)
  semesterName     String? @map("semester_name") @db.VarChar(100)
  subjectName      String @map("subject_name") @db.VarChar(150)

  percentage Decimal @db.Decimal(8, 2)
  letterGrade String? @map("letter_grade") @db.VarChar(10)
  gradePoint Decimal? @map("grade_point") @db.Decimal(5, 2)
  gradeRemark String? @map("grade_remark") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  transcript StudentAcademicTranscript @relation(fields: [transcriptId, schoolId],references: [id, schoolId],onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  grade Grade @relation(fields: [gradeId, schoolId], references: [id, schoolId], onDelete: Restrict)
  semester Semester? @relation(fields: [semesterId, schoolId], references: [id, schoolId], onDelete: Restrict)
  subject Subject @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Restrict)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([schoolId, transcriptId, periodKey, subjectId])
  @@unique([id, schoolId])
  @@index([schoolId, academicYearId, gradeId])
  @@map("academic_transcript_entries")
}

model AcademicTranscriptHistory {
  id           String @id @default(uuid()) @db.Uuid
  schoolId     String @map("school_id") @db.Uuid
  transcriptId String @map("transcript_id") @db.Uuid
  performedById String @map("performed_by_id") @db.Uuid

  action String @db.VarChar(50)
  description String? @db.Text
  previousValues Json? @map("previous_values")
  newValues Json? @map("new_values")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  transcript StudentAcademicTranscript @relation(fields: [transcriptId, schoolId],references: [id, schoolId],onDelete: Cascade)
  performedBy User @relation("TranscriptHistoryActor", fields: [performedById], references: [id], onDelete: Restrict)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, transcriptId, createdAt])
  @@map("academic_transcript_history")
}





enum AttendanceReportScope {
  STUDENT
  SECTION

  @@map("attendance_report_scopes")
}

model AttendanceReport {
  id             String @id @default(uuid()) @db.Uuid
  schoolId       String @map("school_id") @db.Uuid
  academicYearId String @map("academic_year_id") @db.Uuid

  studentId  String? @map("student_id") @db.Uuid
  sectionId  String? @map("section_id") @db.Uuid
  semesterId String? @map("semester_id") @db.Uuid

  reportNumber String @map("report_number") @db.VarChar(100)
  scope AttendanceReportScope

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  totalSessions Int @default(0) @map("total_sessions")
  presentCount  Int @default(0) @map("present_count")
  absentCount   Int @default(0) @map("absent_count")
  lateCount     Int @default(0) @map("late_count")
  excusedCount  Int @default(0) @map("excused_count")
  halfDayCount  Int @default(0) @map("half_day_count")

  attendancePercentage Decimal? @map("attendance_percentage") @db.Decimal(8, 2)

  reportDetails Json? @map("report_details")

  generatedById String @map("generated_by_id") @db.Uuid
  generatedAt DateTime @default(now()) @map("generated_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Restrict)
  student Student? @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Restrict)
  section Section? @relation(fields: [sectionId, schoolId], references: [id, schoolId], onDelete: Restrict)
  semester Semester? @relation(fields: [semesterId, schoolId], references: [id, schoolId], onDelete: Restrict)
  generatedBy User @relation("AttendanceReportGenerator", fields: [generatedById], references: [id], onDelete: Restrict)

  @@unique([id, schoolId])
  @@unique([schoolId, reportNumber])
  @@index([schoolId, studentId, academicYearId])
  @@index([schoolId, sectionId, academicYearId])
  @@index([schoolId, generatedAt])
  @@map("attendance_reports")
}
